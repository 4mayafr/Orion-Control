# ============================================================================
# ORION CONTROL — website environment template
# Copy this file to apps/web/.env.local and fill in the values.
# Never commit the filled-in file.
# ============================================================================

# Hosted PostgreSQL (Neon or Supabase). Required in production.
# Leave empty for local development to use the JSON file driver.
DATABASE_URL=

# Required in production. Generate:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# One-time token for /setup (first administrator). Generate like SESSION_SECRET.
INITIAL_ADMIN_SETUP_TOKEN=

# Optional bearer token for the maintenance cron endpoint.
CRON_SECRET=

# Optional product name.
NEXT_PUBLIC_APP_NAME="ORION CONTROL"

# Force the local JSON file driver even if DATABASE_URL is set (local only).
# ORION_STORAGE=file

# Show clearly-labelled simulated placeholders when nothing has been collected.
# ORION_ALLOW_SIMULATED=true
