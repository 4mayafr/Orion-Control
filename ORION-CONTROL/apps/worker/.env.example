# ============================================================================
# ORION CONTROL — worker environment
# Copy to apps/worker/.env (never commit the filled-in file).
# ============================================================================

# The deployed website (https) or http://localhost:3000 for local development.
ORION_API_URL=http://localhost:3000

# API key with the "worker" scope, created at /dashboard/api-keys. Shown once.
ORION_WORKER_KEY=

# Stable id for this machine. Defaults to the hostname.
WORKER_ID=

# mock    = generate clearly-labelled simulated data (no Discord required)
# channel = post requests to your private channel and parse the reply
INTEGRATION_MODE=mock

# ── Discord (required for INTEGRATION_MODE=channel) ─────────────────────────
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=
# Optional: only accept responses from this bot id.
DISCORD_TARGET_BOT_ID=
# Only enable after turning on the privileged intent in the Discord portal.
DISCORD_ENABLE_MESSAGE_CONTENT=false

# ── Timing ──────────────────────────────────────────────────────────────────
DISCORD_TASK_TIMEOUT=60000
DISCORD_TASK_POLL_INTERVAL=2000
HEARTBEAT_INTERVAL_MS=20000

# debug | info | warn | error
LOG_LEVEL=info
