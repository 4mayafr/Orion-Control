# ============================================================================
# ORION CONTROL — environment template
# ----------------------------------------------------------------------------
# This project has TWO independently running programs:
#
#   1. WEBSITE  (apps/web)     -> copy the "WEBSITE" block into apps/web/.env.local
#   2. WORKER   (apps/worker)  -> copy the "WORKER" block into apps/worker/.env
#
# Never commit real values. Never put worker/Discord secrets in anything that
# starts with NEXT_PUBLIC_ — those are shipped to the browser.
# On Vercel, set the website variables in Project -> Settings -> Environment
# Variables. On the Chromebook, the worker variables live in apps/worker/.env.
# ============================================================================


# ─────────────────────────────── WEBSITE ────────────────────────────────────
# Hosted PostgreSQL connection string (Neon, Supabase, or any Postgres 13+).
# Leave EMPTY for local development: the site then uses a JSON file database in
# apps/web/.data and labels itself "Local file storage" in the UI.
# Vercel/serverless REQUIRES this to be set — local files are not persistent.
DATABASE_URL=

# Secret used to sign login session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Required. Must be at least 32 characters. Changing it logs everyone out.
SESSION_SECRET=

# One-time token required by the /setup page to create the very first admin.
# Generate one the same way as SESSION_SECRET. Setup is disabled automatically
# once an operator account exists.
INITIAL_ADMIN_SETUP_TOKEN=

# Optional: bearer token for the /api/maintenance/reap cron endpoint.
# Vercel Cron sends it automatically when configured (see apps/web/vercel.json).
CRON_SECRET=

# Optional: public product name shown in the interface.
NEXT_PUBLIC_APP_NAME="ORION CONTROL"

# Optional storage override: "file" forces the JSON file driver even when
# DATABASE_URL is set. Used only for local testing. Do not use on Vercel.
# ORION_STORAGE=file

# Optional: allow the dashboard to render simulated placeholder statistics
# when no retrieval exists yet (default true). Simulated data is always
# labelled in the interface.
# ORION_ALLOW_SIMULATED=true


# ─────────────────────────────── WORKER ─────────────────────────────────────
# Base URL of the deployed website (no trailing slash).
# Local development: http://localhost:3000
# Production:        https://your-project.vercel.app
ORION_API_URL=http://localhost:3000

# Worker API key. Create it in the dashboard: API Keys -> Create key.
# It is shown ONCE. Scope required: "worker".
ORION_WORKER_KEY=

# Stable identifier for this machine. Defaults to the hostname.
# Use a different value per Chromebook/worker you run.
WORKER_ID=

# How often the worker asks the website for work (milliseconds).
DISCORD_TASK_POLL_INTERVAL=2000

# Maximum time a single task may run (milliseconds). The server also enforces
# its own timeout; the lower of the two wins.
DISCORD_TASK_TIMEOUT=60000

# How often the worker reports health (milliseconds).
HEARTBEAT_INTERVAL_MS=20000

# ─────────────────────────────── DISCORD ────────────────────────────────────
# Discord bot token from https://discord.com/developers/applications
# Never share it, never commit it.
DISCORD_BOT_TOKEN=

# Discord server (guild) that contains the private operations channel.
DISCORD_GUILD_ID=

# The private channel the bot uses for operations. The worker validates that
# this channel really belongs to DISCORD_GUILD_ID before doing anything.
DISCORD_CHANNEL_ID=

# Optional: the bot ID of the authorised integration that posts responses in
# the operations channel. When set, only messages from this bot are accepted.
DISCORD_TARGET_BOT_ID=

# Optional: enable the privileged MESSAGE_CONTENT intent. Only turn this on if
# you enabled it in the Discord Developer Portal (Bot -> Privileged Gateway
# Intents). The worker works without it by reading embeds.
DISCORD_ENABLE_MESSAGE_CONTENT=false

# Integration mode:
#   mock    -> generate clearly-labelled simulated data (default, no target bot
#              required). Use this to test the full website <-> worker pipeline.
#   channel -> post a request in the operations channel and parse the reply from
#              an authorised integration bot. See docs/DISCORD.md for the
#              platform limitation that makes direct slash-command invocation
#              impossible.
INTEGRATION_MODE=mock

# Logging: debug | info | warn | error
LOG_LEVEL=info
